{"title": "Building blocks", "levels": [
{"name": "Half adder", "inputs": ["a", "b"], "outputs": ["sum", "carry"], "spec": {"sum": "XOR(a,b)", "carry": "AND(a,b)"}, "solution": {"sum": "ONLYONE(a,b)", "carry": "BOTH(a,b)"}, "parts": ["BOTH", "EITHER", "FLIP", "ONLYONE"], "goal": "Add two bits: sum is the ones digit, carry is the twos.", "makes": "HALFADD", "intro": "numbers", "numbers": [{"label": "a + b", "bits": ["sum", "carry"]}]}, 
{"name": "Full adder", "inputs": ["a", "b", "cin"], "outputs": ["sum", "cout"], "spec": {"sum": "XOR(XOR(a,b),cin)", "cout": "OR(AND(a,b),AND(cin,XOR(a,b)))"}, "solution": {"sum": "HALFADD(HALFADD(a,b).sum,cin).sum", "cout": "EITHER(HALFADD(a,b).carry,HALFADD(HALFADD(a,b).sum,cin).carry)"}, "parts": ["BOTH", "EITHER", "FLIP", "ONLYONE", "HALFADD"], "goal": "Add three bits (a, b and a carry in).", "makes": "FULLADD", "intro": "chips", "numbers": [{"label": "a + b + cin", "bits": ["sum", "cout"]}]}, 
{"name": "Selector", "inputs": ["a", "b", "s"], "outputs": ["out"], "spec": {"out": "OR(AND(a,NOT(s)),AND(b,s))"}, "solution": {"out": "EITHER(BOTH(a,FLIP(s)),BOTH(b,s))"}, "parts": ["BOTH", "EITHER", "FLIP", "ONLYONE", "HALFADD"], "goal": "Pass a through when s is OFF, and b when s is ON.", "makes": "SELECT"}, 
{"name": "Equal?", "inputs": ["a0", "a1", "b0", "b1"], "outputs": ["same"], "spec": {"same": "AND(XNOR(a0,b0),XNOR(a1,b1))"}, "solution": {"same": "FLIP(EITHER(ONLYONE(a0,b0),ONLYONE(a1,b1)))"}, "parts": ["BOTH", "EITHER", "FLIP", "ONLYONE", "HALFADD"], "goal": "Light the bulb when number A equals number B.", "numbers": [{"label": "A", "bits": ["a0", "a1"]}, {"label": "B", "bits": ["b0", "b1"]}]}, 
{"name": "Pick a lamp", "inputs": ["d", "s"], "outputs": ["x", "y"], "spec": {"x": "AND(d,NOT(s))", "y": "AND(d,s)"}, "solution": {"x": "BOTH(d,FLIP(s))", "y": "BOTH(d,s)"}, "parts": ["BOTH", "EITHER", "FLIP", "ONLYONE", "HALFADD"], "goal": "Send d to lamp x when s is OFF, to lamp y when s is ON."}, 
{"name": "Swap", "inputs": ["a", "b", "s"], "outputs": ["x", "y"], "spec": {"x": "OR(AND(a,NOT(s)),AND(b,s))", "y": "OR(AND(b,NOT(s)),AND(a,s))"}, "solution": {"x": "SELECT(a,b,s)", "y": "SELECT(b,a,s)"}, "parts": ["BOTH", "EITHER", "FLIP", "ONLYONE", "HALFADD", "SELECT"], "goal": "When s is ON, swap a and b. When OFF, pass them straight."}, 
{"name": "Bigger bit", "inputs": ["a", "b"], "outputs": ["a_wins", "tie", "b_wins"], "spec": {"a_wins": "AND(a,NOT(b))", "tie": "XNOR(a,b)", "b_wins": "AND(b,NOT(a))"}, "solution": {"a_wins": "BOTH(a,FLIP(b))", "tie": "FLIP(EITHER(BOTH(a,FLIP(b)),BOTH(b,FLIP(a))))", "b_wins": "BOTH(b,FLIP(a))"}, "parts": ["BOTH", "EITHER", "FLIP", "ONLYONE", "HALFADD"], "goal": "Compare two bits: which is bigger, or a tie?"}, 
{"name": "Decoder", "inputs": ["a0", "a1"], "outputs": ["y0", "y1", "y2", "y3"], "spec": {"y0": "NOR(a0,a1)", "y1": "AND(a0,NOT(a1))", "y2": "AND(a1,NOT(a0))", "y3": "AND(a0,a1)"}, "solution": {"y0": "BOTH(FLIP(a1),FLIP(a0))", "y1": "BOTH(FLIP(a1),a0)", "y2": "BOTH(a1,FLIP(a0))", "y3": "BOTH(a1,a0)"}, "parts": ["BOTH", "EITHER", "FLIP", "ONLYONE", "HALFADD"], "goal": "Light lamp y0, y1, y2 or y3 to match the number on the switches.", "numbers": [{"label": "number", "bits": ["a0", "a1"]}]}]}
