{
  "name": "pocket-arcade",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run verify-levels && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "test": "vitest run",
    "sim": "tsx scripts/simulate-bid-war.ts",
    "pack:pokemon": "NODE_USE_ENV_PROXY=1 tsx scripts/build-pokemon-pack.ts",
    "pack:heroes": "NODE_USE_ENV_PROXY=1 tsx scripts/build-heroes-pack.ts",
    "packs": "npm run pack:pokemon && npm run pack:heroes",
    "verify-levels": "tsx scripts/verify-levels.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
