{"title": "Combos", "levels": [
{"name": "Only one", "inputs": ["a", "b"], "outputs": ["bulb"], "spec": {"bulb": "XOR(a,b)"}, "solution": {"bulb": "BOTH(EITHER(a,b),FLIP(BOTH(a,b)))"}, "parts": ["BOTH", "EITHER", "FLIP"], "goal": "Light the bulb when exactly one switch is ON.", "makes": "ONLYONE"}, 
{"name": "Same", "inputs": ["a", "b"], "outputs": ["bulb"], "spec": {"bulb": "XNOR(a,b)"}, "solution": {"bulb": "FLIP(ONLYONE(a,b))"}, "parts": ["BOTH", "EITHER", "FLIP", "ONLYONE"], "goal": "Light the bulb when the two switches match.", "intro": "ONLYONE"}, 
{"name": "Majority vote", "inputs": ["a", "b", "c"], "outputs": ["bulb"], "spec": {"bulb": "OR(OR(AND(a,b),AND(b,c)),AND(a,c))"}, "solution": {"bulb": "EITHER(BOTH(a,b),BOTH(c,EITHER(a,b)))"}, "parts": ["BOTH", "EITHER", "FLIP", "ONLYONE"], "goal": "Light the bulb when at least two of the three switches are ON."}, 
{"name": "Password", "inputs": ["a", "b", "c", "d"], "outputs": ["open"], "spec": {"open": "AND(AND(a,NOT(b)),AND(c,d))"}, "solution": {"open": "BOTH(BOTH(a,FLIP(b)),BOTH(c,d))"}, "parts": ["BOTH", "EITHER", "FLIP", "ONLYONE"], "goal": "Open the lock only for the code ON, OFF, ON, ON."}, 
{"name": "Two lamps", "inputs": ["a", "b"], "outputs": ["both", "any"], "spec": {"both": "AND(a,b)", "any": "OR(a,b)"}, "solution": {"both": "BOTH(a,b)", "any": "EITHER(a,b)"}, "parts": ["BOTH", "EITHER", "FLIP", "ONLYONE"], "goal": "Top lamp: both switches ON. Bottom lamp: any switch ON.", "intro": "fanout"}, 
{"name": "Odd one out", "inputs": ["a", "b", "c"], "outputs": ["bulb"], "spec": {"bulb": "XOR(XOR(a,b),c)"}, "solution": {"bulb": "ONLYONE(ONLYONE(a,b),c)"}, "parts": ["BOTH", "EITHER", "FLIP", "ONLYONE"], "goal": "Light the bulb when an odd number of switches are ON."}, 
{"name": "Crossing", "inputs": ["button", "car"], "outputs": ["walk", "stop"], "spec": {"walk": "AND(button,NOT(car))", "stop": "NAND(button,NOT(car))"}, "solution": {"walk": "BOTH(button,FLIP(car))", "stop": "FLIP(BOTH(button,FLIP(car)))"}, "parts": ["BOTH", "EITHER", "FLIP", "ONLYONE"], "goal": "Show WALK when the button is pressed and no car is coming. Otherwise STOP."}, 
{"name": "Exactly two", "inputs": ["a", "b", "c"], "outputs": ["bulb"], "spec": {"bulb": "AND(OR(OR(AND(a,b),AND(b,c)),AND(a,c)),NOT(AND(AND(a,b),c)))"}, "solution": {"bulb": "BOTH(EITHER(BOTH(a,b),BOTH(c,EITHER(a,b))),FLIP(BOTH(BOTH(a,b),c)))"}, "parts": ["BOTH", "EITHER", "FLIP", "ONLYONE"], "goal": "Light the bulb when exactly two switches are ON."}]}
